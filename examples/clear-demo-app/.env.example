# Copy to .env.local for local runs; on Vercel set these in Project → Settings → Environment Variables.

# Turns the ApiLens server SDK on. Leave unset (or false) and the app runs without it.
APILENS_ENABLED=true

# Shared secret the extension uses to read server calls and push server mocks.
# At least 24 characters. Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
APILENS_CONTROL_TOKEN=

# Optional: where the dummy backend services live. Defaults to this app's own origin.
# SERVICES_BASE_URL=
