{
  "name": "@apilens/next-sdk",
  "version": "0.5.0",
  "description": "Opt-in Node-runtime and Edge-middleware capture, payload inspection and server mocking for ApiLens",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "default": "./dist/edge.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "edge.js",
    "edge.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "axios": "1.7.9",
    "typescript": "~5.5.0",
    "vitest": "^1.6.0"
  }
}
