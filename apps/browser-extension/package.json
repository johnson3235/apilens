{
  "name": "@apilens/browser-extension",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "verify:build": "node scripts/verify-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm verify:build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@apilens/api-diff": "workspace:*",
    "@apilens/contract-validation": "workspace:*",
    "@apilens/core": "workspace:*",
    "@apilens/evidence": "workspace:*",
    "@apilens/insights": "workspace:*",
    "@apilens/mock-engine": "workspace:*",
    "@apilens/replay-engine": "workspace:*",
    "@apilens/security": "workspace:*",
    "@apilens/shared-types": "workspace:*",
    "@apilens/trace-engine": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.263",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "esbuild": "^0.21.5",
    "typescript": "~5.5.0",
    "vitest": "^1.6.0"
  }
}
