{
  "name": "@apilens/browser-extension",
  "version": "0.6.1",
  "private": true,
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:build": "node scripts/verify-build.mjs",
    "build:firefox": "pnpm build && node scripts/prepare-firefox.mjs",
    "verify:firefox": "node scripts/verify-firefox-build.mjs",
    "build:safari": "pnpm build && node scripts/prepare-safari.mjs",
    "verify:safari": "node scripts/verify-safari-build.mjs",
    "check": "pnpm test && pnpm build && pnpm verify:build",
    "check:all": "pnpm check && pnpm build:firefox && pnpm verify:firefox && pnpm build:safari && pnpm verify:safari"
  },
  "dependencies": {
    "@apilens/rule-engine": "workspace:*",
    "@apilens/shared-types": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.263",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.4.2",
    "vite": "^5.1.6",
    "vitest": "^1.3.1"
  }
}
